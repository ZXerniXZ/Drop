OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=google/gemini-3.6-flash
TRANSCRIPTION_TIMEOUT_SECONDS=600
LLM_TIMEOUT_SECONDS=300
SEGMENT_TARGET_SECONDS=300
SERVER_AUDIO_QUOTA_SECONDS=7200

# Versione minima accettata. Alza questi valori per spegnere le release precedenti.
MIN_APP_VERSION=1.0.4
MIN_APP_BUILD=30
APP_UPDATE_ANDROID_URL=https://github.com/ZXerniXZ/Drop/releases/latest
APP_UPDATE_WEB_URL=https://drop-app-3x2.pages.dev

BACKEND_PORT=8080

DATABASE_URL=sqlite:////app/data/drop_backend.db

# Auth self-host (GoTrue + Postgres). Genera JWT_SECRET, ANON_KEY e
# SERVICE_ROLE_KEY con: python3 scripts/gen-jwt-keys.py
AUTH_PORT=8090
AUTH_POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600
API_EXTERNAL_URL=https://auth.drop-prj.xyz/auth/v1
SITE_URL=https://app.drop-prj.xyz
GOTRUE_URI_ALLOW_LIST=https://app.drop-prj.xyz,https://app.drop-prj.xyz/**,https://*.pages.dev,https://*.pages.dev/**,http://localhost:*,http://127.0.0.1:*,com.drop.plaudclone.drop://**

# FastAPI verifica gli stessi JWT HS256 di GoTrue (stesso secret).
SUPABASE_URL=https://auth.drop-prj.xyz
SUPABASE_JWT_SECRET=

# Email di conferma via Brevo. Lascia AUTOCONFIRM=true finché il dominio
# non è verificato e SMTP_PASS non è la chiave SMTP (non la password dell'account).
# Pannello: https://app.brevo.com/settings/keys/smtp
GOTRUE_MAILER_AUTOCONFIRM=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@drop-prj.xyz
SMTP_SENDER_NAME=Drop

# OAuth: Authorized redirect URI = https://auth.drop-prj.xyz/auth/v1/callback
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GITHUB_ENABLED=true
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=

CORS_ORIGIN_REGEX=https://app\.drop-prj\.xyz|https://[a-z0-9.-]+\.pages\.dev|http://localhost:\d+|http://127\.0\.0\.1:\d+
